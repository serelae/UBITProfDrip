<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="1000" height="1000" style="background:#FFFFFF;">
  <!-- Pure Solid White Background -->
  <rect width="1000" height="1000" fill="#FFFFFF"/>

  <!-- Subtle E-Commerce Catalog Grid & Badges -->
  <rect x="40" y="40" width="920" height="920" rx="16" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="2"/>
  
  <text x="70" y="85" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="700" fill="#111827" letter-spacing="1.5">UBITPROFDRIP // FASHION EXTRACTION DECONSTRUCTION</text>
  <text x="70" y="110" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="500" fill="#6B7280">TARGET: MR. AYAZ AHMED // BACKGROUND: #FFFFFF SOLID</text>
  <line x1="70" y1="130" x2="930" y2="130" stroke="#F3F4F6" stroke-width="2"/>

  <!-- Main Extracted Clothing Display Container -->
  <g transform="translate(100, 160)">
    <!-- Top Piece Box -->
    <rect x="0" y="0" width="380" height="340" rx="12" fill="#FAFAFA" stroke="#E5E7EB" stroke-width="1.5"/>
    <text x="20" y="32" font-family="sans-serif" font-size="12" font-weight="700" fill="#0284C7" letter-spacing="1">01. TOP APPAREL [ISOLATED]</text>
    
    <!-- Isolated Top Vector Flat Lay Art -->
    <g transform="translate(190, 180) scale(1.1)">
      <!-- Collar -->
      <path d="M-40,-80 L-10,-50 L0,-70 L10,-50 L40,-80 L25,-90 L-25,-90 Z" fill="#3B82F6" stroke="#1D4ED8" stroke-width="2"/>
      <!-- Body & Sleeves -->
      <path d="M-40,-80 L-95,-10 L-65,10 L-45,-20 L-45,80 L45,80 L45,-20 L65,10 L95,-10 L40,-80 Z" fill="#60A5FA" stroke="#1D4ED8" stroke-width="3" stroke-linejoin="round"/>
      <!-- Buttons -->
      <circle cx="0" cy="-30" r="3" fill="#FFFFFF"/>
      <circle cx="0" cy="0" r="3" fill="#FFFFFF"/>
      <circle cx="0" cy="30" r="3" fill="#FFFFFF"/>
      <circle cx="0" cy="60" r="3" fill="#FFFFFF"/>
      <!-- Pocket with pen -->
      <rect x="15" y="-15" width="22" height="26" rx="2" fill="#3B82F6" stroke="#1D4ED8" stroke-width="1.5"/>
      <line x1="26" y1="-22" x2="26" y2="-12" stroke="#EF4444" stroke-width="3" stroke-linecap="round"/>
    </g>
    <text x="20" y="315" font-family="sans-serif" font-size="12" font-weight="600" fill="#374151">Chalk-Proof Oxford Shirt</text>

    <!-- Bottom Piece Box -->
    <rect x="420" y="0" width="380" height="340" rx="12" fill="#FAFAFA" stroke="#E5E7EB" stroke-width="1.5"/>
    <text x="440" y="32" font-family="sans-serif" font-size="12" font-weight="700" fill="#0284C7" letter-spacing="1">02. BOTTOMS [ISOLATED]</text>
    
    <!-- Isolated Pants Vector Flat Lay Art -->
    <g transform="translate(610, 180) scale(1.05)">
      <!-- Waistband & Belt -->
      <rect x="-45" y="-85" width="90" height="14" rx="2" fill="#78716C" stroke="#44403C" stroke-width="2"/>
      <rect x="-8" y="-87" width="16" height="18" rx="2" fill="#E5E7EB" stroke="#44403C" stroke-width="1.5"/>
      <!-- Legs -->
      <path d="M-45,-71 L-48,75 L-12,75 L-2,-10 L8,-10 L18,75 L54,75 L51,-71 Z" fill="#A8A29E" stroke="#57534E" stroke-width="3" stroke-linejoin="round"/>
      <!-- Cargo Pockets -->
      <rect x="-48" y="-10" width="12" height="30" rx="2" fill="#78716C" stroke="#44403C" stroke-width="1.5"/>
      <rect x="42" y="-10" width="12" height="30" rx="2" fill="#78716C" stroke="#44403C" stroke-width="1.5"/>
    </g>
    <text x="440" y="315" font-family="sans-serif" font-size="12" font-weight="600" fill="#374151">Multi-Pocket Tenured Chinos</text>

    <!-- Footwear Box -->
    <rect x="0" y="370" width="380" height="340" rx="12" fill="#FAFAFA" stroke="#E5E7EB" stroke-width="1.5"/>
    <text x="20" y="402" font-family="sans-serif" font-size="12" font-weight="700" fill="#0284C7" letter-spacing="1">03. FOOTWEAR [ISOLATED]</text>
    
    <!-- Isolated Shoes Vector Flat Lay Art -->
    <g transform="translate(190, 545) scale(1.1)">
      <!-- Left Shoe -->
      <path d="M-60,15 C-60,0 -40,-20 -15,-20 C-5,-20 5,-10 10,0 L15,15 Z" fill="#1F2937" stroke="#111827" stroke-width="2"/>
      <rect x="-62" y="15" width="80" height="12" rx="3" fill="#E5E7EB" stroke="#9CA3AF" stroke-width="1.5"/>
      <!-- Right Shoe -->
      <path d="M-10,15 C-10,0 10,-20 35,-20 C45,-20 55,-10 60,0 L65,15 Z" fill="#1F2937" stroke="#111827" stroke-width="2"/>
      <rect x="-12" y="15" width="80" height="12" rx="3" fill="#E5E7EB" stroke="#9CA3AF" stroke-width="1.5"/>
    </g>
    <text x="20" y="685" font-family="sans-serif" font-size="12" font-weight="600" fill="#374151">Ergonomic Hallway Walkers</text>

    <!-- Academic Gear / Accessories Box -->
    <rect x="420" y="370" width="380" height="340" rx="12" fill="#FAFAFA" stroke="#E5E7EB" stroke-width="1.5"/>
    <text x="440" y="402" font-family="sans-serif" font-size="12" font-weight="700" fill="#0284C7" letter-spacing="1">04. ESSENTIAL GEAR [ISOLATED]</text>
    
    <!-- Isolated Glasses & Badge Art -->
    <g transform="translate(610, 545) scale(1.15)">
      <!-- Glasses -->
      <circle cx="-25" cy="-20" r="18" fill="none" stroke="#1F2937" stroke-width="3"/>
      <circle cx="25" cy="-20" r="18" fill="none" stroke="#1F2937" stroke-width="3"/>
      <line x1="-7" y1="-20" x2="7" y2="-20" stroke="#1F2937" stroke-width="3"/>
      <path d="M-43,-20 L-60,-28" stroke="#1F2937" stroke-width="2.5"/>
      <path d="M43,-20 L60,-28" stroke="#1F2937" stroke-width="2.5"/>
      
      <!-- Keycard Lanyard -->
      <path d="M-15,10 C-15,35 15,35 15,10" fill="none" stroke="#0284C7" stroke-width="4"/>
      <rect x="-16" y="25" width="32" height="42" rx="4" fill="#F3F4F6" stroke="#9CA3AF" stroke-width="1.5"/>
      <rect x="-10" y="30" width="20" height="15" fill="#38BDF8"/>
      <line x1="-10" y1="52" x2="10" y2="52" stroke="#6B7280" stroke-width="2"/>
    </g>
    <text x="440" y="685" font-family="sans-serif" font-size="12" font-weight="600" fill="#374151">Faculty ID &amp; Anti-Glare Specs</text>
  </g>

  <!-- Footer Seal -->
  <text x="500" y="930" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" fill="#9CA3AF" letter-spacing="2">AUTHENTICATED CAMPUS DRIP EXTRACTION // SOLID WHITE SPECIFICATION</text>
</svg>