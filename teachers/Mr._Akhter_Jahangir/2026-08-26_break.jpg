<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="1000" height="1000" style="background:#FFFFFF;">
  <!-- Pure Solid White Background (#FFFFFF) -->
  <rect width="1000" height="1000" fill="#FFFFFF"/>

  <!-- E-Commerce Catalog Framing -->
  <rect x="30" y="30" width="940" height="940" rx="20" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="2"/>
  
  <!-- Header Banner -->
  <g transform="translate(60, 75)">
    <rect x="0" y="0" width="880" height="70" rx="12" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1.5"/>
    <text x="25" y="32" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="15" font-weight="800" fill="#0F172A" letter-spacing="1.5">UBITPROFDRIP // SARTORIAL EXTRACTION LOOKBOOK</text>
    <text x="25" y="52" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="600" fill="#64748B">PROF: MR. AKHTER JAHANGIR &bull; VIBE: DEPARTMENT MEETING DAYDREAMER &bull; SCORE: 4.2/10</text>
    
    <rect x="750" y="16" width="105" height="36" rx="8" fill="#0284C7"/>
    <text x="802" y="39" font-family="sans-serif" font-size="11" font-weight="700" fill="#FFFFFF" text-anchor="middle" letter-spacing="1">#FFFFFF FLAT</text>
  </g>

  <!-- 4-Quadrant Product Breakdown Grid -->
  <g transform="translate(60, 170)">
    <!-- 01. Top Item -->
    <g transform="translate(0, 0)">
      <rect width="425" height="355" rx="16" fill="#FAFAFA" stroke="#E2E8F0" stroke-width="1.5"/>
      <rect x="18" y="16" width="120" height="24" rx="6" fill="#E0F2FE"/>
      <text x="26" y="32" font-family="sans-serif" font-size="10" font-weight="800" fill="#0369A1" letter-spacing="0.5">01. UPPER APPAREL</text>
      
      <!-- Isolated Top Visual Art -->
      <g transform="translate(212, 165) scale(1.15)">
        <!-- Collar -->
        <path d="M-36,-65 L-10,-40 L0,-55 L10,-40 L36,-65 L22,-75 L-22,-75 Z" fill="#0284C7" stroke="#0369A1" stroke-width="2"/>
        <!-- Body & Sleeves -->
        <path d="M-36,-65 L-85,-10 L-60,8 L-40,-15 L-40,65 L40,65 L40,-15 L60,8 L85,-10 L36,-65 Z" fill="#38BDF8" stroke="#0284C7" stroke-width="3" stroke-linejoin="round"/>
        <!-- Placket & Buttons -->
        <line x1="0" y1="-55" x2="0" y2="65" stroke="#0284C7" stroke-width="2"/>
        <circle cx="0" cy="-25" r="2.5" fill="#FFFFFF"/>
        <circle cx="0" cy="0" r="2.5" fill="#FFFFFF"/>
        <circle cx="0" cy="25" r="2.5" fill="#FFFFFF"/>
        <circle cx="0" cy="50" r="2.5" fill="#FFFFFF"/>
        <!-- Pocket -->
        <rect x="12" y="-12" width="20" height="24" rx="2" fill="#0284C7" stroke="#0369A1" stroke-width="1.5"/>
        <line x1="22" y1="-18" x2="22" y2="-9" stroke="#EF4444" stroke-width="2.5" stroke-linecap="round"/>
      </g>

      <text x="20" y="305" font-family="sans-serif" font-size="14" font-weight="700" fill="#0F172A">The &apos;Dusty Rose&apos; Lecture Hall Button-Down</text>
      <text x="20" y="328" font-family="sans-serif" font-size="12" font-weight="600" fill="#D97706">$24.99 at a department store clearance rack</text>
      <text x="405" y="328" font-family="sans-serif" font-size="11" font-weight="500" fill="#64748B" text-anchor="end">ISOLATED PIECE</text>
    </g>

    <!-- 02. Bottom Item -->
    <g transform="translate(455, 0)">
      <rect width="425" height="355" rx="16" fill="#FAFAFA" stroke="#E2E8F0" stroke-width="1.5"/>
      <rect x="18" y="16" width="105" height="24" rx="6" fill="#E0F2FE"/>
      <text x="26" y="32" font-family="sans-serif" font-size="10" font-weight="800" fill="#0369A1" letter-spacing="0.5">02. BOTTOMS</text>
      
      <!-- Isolated Pants Visual Art -->
      <g transform="translate(212, 165) scale(1.1)">
        <!-- Belt -->
        <rect x="-42" y="-75" width="84" height="12" rx="2" fill="#475569" stroke="#334155" stroke-width="2"/>
        <rect x="-7" y="-77" width="14" height="16" rx="2" fill="#E2E8F0" stroke="#334155" stroke-width="1.5"/>
        <!-- Legs -->
        <path d="M-42,-63 L-45,65 L-12,65 L-2,-10 L2,-10 L12,65 L45,65 L42,-63 Z" fill="#94A3B8" stroke="#475569" stroke-width="3" stroke-linejoin="round"/>
        <!-- Pockets -->
        <rect x="-45" y="-12" width="10" height="25" rx="2" fill="#64748B"/>
        <rect x="35" y="-12" width="10" height="25" rx="2" fill="#64748B"/>
      </g>

      <text x="20" y="305" font-family="sans-serif" font-size="14" font-weight="700" fill="#0F172A">The Tactical Stationary Arsenal</text>
      <text x="20" y="328" font-family="sans-serif" font-size="12" font-weight="600" fill="#D97706">$1.50 for the set, plus the emotional cost of a broken lead</text>
      <text x="405" y="328" font-family="sans-serif" font-size="11" font-weight="500" fill="#64748B" text-anchor="end">ISOLATED PIECE</text>
    </g>

    <!-- 03. Shoes Item -->
    <g transform="translate(0, 380)">
      <rect width="425" height="355" rx="16" fill="#FAFAFA" stroke="#E2E8F0" stroke-width="1.5"/>
      <rect x="18" y="16" width="105" height="24" rx="6" fill="#E0F2FE"/>
      <text x="26" y="32" font-family="sans-serif" font-size="10" font-weight="800" fill="#0369A1" letter-spacing="0.5">03. FOOTWEAR</text>
      
      <!-- Isolated Footwear Visual Art -->
      <g transform="translate(212, 170) scale(1.2)">
        <!-- Left Shoe -->
        <path d="M-55,10 C-55,-5 -35,-22 -12,-22 C-2,-22 8,-12 12,-2 L15,10 Z" fill="#1E293B" stroke="#0F172A" stroke-width="2"/>
        <rect x="-57" y="10" width="74" height="12" rx="3" fill="#E2E8F0" stroke="#94A3B8" stroke-width="1.5"/>
        <line x1="-30" y1="-8" x2="-10" y2="-8" stroke="#38BDF8" stroke-width="2"/>
        <!-- Right Shoe -->
        <path d="M-10,10 C-10,-5 10,-22 32,-22 C42,-22 52,-12 56,-2 L60,10 Z" fill="#1E293B" stroke="#0F172A" stroke-width="2"/>
        <rect x="-12" y="10" width="74" height="12" rx="3" fill="#E2E8F0" stroke="#94A3B8" stroke-width="1.5"/>
        <line x1="15" y1="-8" x2="35" y2="-8" stroke="#38BDF8" stroke-width="2"/>
      </g>

      <text x="20" y="305" font-family="sans-serif" font-size="14" font-weight="700" fill="#0F172A">Hallway Sneakers</text>
      <text x="20" y="328" font-family="sans-serif" font-size="12" font-weight="600" fill="#D97706">$89.99</text>
      <text x="405" y="328" font-family="sans-serif" font-size="11" font-weight="500" fill="#64748B" text-anchor="end">ISOLATED PIECE</text>
    </g>

    <!-- 04. Accessories / Gear Item -->
    <g transform="translate(455, 380)">
      <rect width="425" height="355" rx="16" fill="#FAFAFA" stroke="#E2E8F0" stroke-width="1.5"/>
      <rect x="18" y="16" width="125" height="24" rx="6" fill="#E0F2FE"/>
      <text x="26" y="32" font-family="sans-serif" font-size="10" font-weight="800" fill="#0369A1" letter-spacing="0.5">04. ESSENTIAL GEAR</text>
      
      <!-- Isolated Accessories Visual Art -->
      <g transform="translate(212, 170) scale(1.25)">
        <!-- Glasses -->
        <circle cx="-24" cy="-20" r="16" fill="none" stroke="#1E293B" stroke-width="3"/>
        <circle cx="24" cy="-20" r="16" fill="none" stroke="#1E293B" stroke-width="3"/>
        <line x1="-8" y1="-20" x2="8" y2="-20" stroke="#1E293B" stroke-width="3"/>
        <path d="M-40,-20 L-55,-26" stroke="#1E293B" stroke-width="2.5"/>
        <path d="M40,-20 L55,-26" stroke="#1E293B" stroke-width="2.5"/>
        
        <!-- Keycard Lanyard -->
        <path d="M-12,8 C-12,30 12,30 12,8" fill="none" stroke="#0284C7" stroke-width="3.5"/>
        <rect x="-14" y="20" width="28" height="36" rx="4" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5"/>
        <rect x="-9" y="24" width="18" height="12" fill="#38BDF8"/>
        <line x1="-8" y1="44" x2="8" y2="44" stroke="#64748B" stroke-width="2"/>
      </g>

      <text x="20" y="305" font-family="sans-serif" font-size="14" font-weight="700" fill="#0F172A">The Tactical Stationary Arsenal</text>
      <text x="20" y="328" font-family="sans-serif" font-size="12" font-weight="600" fill="#D97706">$1.50 for the set, plus the emotional cost of a broken lead</text>
      <text x="405" y="328" font-family="sans-serif" font-size="11" font-weight="500" fill="#64748B" text-anchor="end">ISOLATED PIECE</text>
    </g>
  </g>

  <!-- Footer Seal -->
  <text x="500" y="945" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" fill="#94A3B8" letter-spacing="2">SOLID #FFFFFF E-COMMERCE FLAT LAY // UBITPROFDRIP FLUX ENGINE</text>
</svg>